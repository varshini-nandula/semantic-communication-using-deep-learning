### 2.2 Grad-CAM for Image Encoder

**What it does:** Computes per-patch importance by backpropagating gradients from the reconstruction loss to a chosen encoder layer's activations, producing a spatial heatmap.

**Target layer:** The last encoder block *before* the FSM kicks in. In `ViTEncoder_FSM.forward()`, the FSM starts at block `depth - num_FSM`. So the target is block `depth - num_FSM - 1` (i.e., `self.blocks[3]` for the default 6-block image encoder with 2 FSM stages).

```python
# Create: xai/grad_cam_image.py

import torch
import torch.nn.functional as F
import numpy as np
import matplotlib.pyplot as plt

class GradCAMImageEncoder:
    """
    Grad-CAM for ViTEncoder_FSM.
    Hooks into the last pre-FSM encoder block to capture
    activations and gradients.
    """
    def __init__(self, model, target_layer_index=None):
        self.model = model
        self.activations = None
        self.gradients = None
        
        # Default: last block before FSM
        img_encoder = model.img_encoder
        if target_layer_index is None:
            target_layer_index = img_encoder.depth - img_encoder.num_FSM - 1
        
        target_block = img_encoder.blocks[target_layer_index]
        
        # Register hooks
        target_block.register_forward_hook(self._save_activation)
        target_block.register_full_backward_hook(self._save_gradient)
    
    def _save_activation(self, module, input, output):
        self.activations = output.detach()
    
    def _save_gradient(self, module, grad_input, grad_output):
        self.gradients = grad_output[0].detach()
    
    def compute(self, img, ta_perform='imgr', criterion=None, targets=None):
        """
        Returns per-patch importance scores [B, N_patches].
        """
        self.model.zero_grad()
        
        # Forward pass (need gradients, so can't use @torch.no_grad)
        outputs = self.model(img=img, ta_perform=ta_perform)
        if isinstance(outputs, tuple):
            logits = outputs[0]
        else:
            logits = outputs['outputs']
        
        # Compute loss for backprop
        if criterion is not None and targets is not None:
            loss = criterion(logits, targets)
        else:
            # For reconstruction: use the output norm as proxy
            loss = logits.norm()
        
        loss.backward(retain_graph=True)
        
        # Grad-CAM computation
        # activations: [B, N+2, D] (cls + patches + task_embed)
        # gradients:   [B, N+2, D]
        
        # Global average pooling of gradients over feature dim
        weights = self.gradients.mean(dim=-1)  # [B, N+2]
        
        # Weighted combination
        cam = (weights.unsqueeze(-1) * self.activations).sum(dim=-1)  # [B, N+2]
        cam = F.relu(cam)  # Only positive contributions
        
        # Remove cls token and task embedding (first and last tokens)
        cam_patches = cam[:, 1:-1]  # [B, N_patches]
        
        # Normalize per sample
        cam_min = cam_patches.min(dim=1, keepdim=True)[0]
        cam_max = cam_patches.max(dim=1, keepdim=True)[0]
        cam_patches = (cam_patches - cam_min) / (cam_max - cam_min + 1e-8)
        
        return cam_patches  # [B, N_patches], values in [0, 1]
    
    def visualize(self, cam_patches, img, patch_size=32, img_size=224):
        """Overlay Grad-CAM heatmap on the original image."""
        n_patches_side = img_size // patch_size  # 7 for 224/32
        
        cam_2d = cam_patches[0].reshape(n_patches_side, n_patches_side)
        cam_2d = cam_2d.cpu().numpy()
        
        # Upsample to image size
        cam_upsampled = np.kron(cam_2d, np.ones((patch_size, patch_size)))
        
        fig, axes = plt.subplots(1, 3, figsize=(15, 5))
        
        # Original image
        img_np = img[0].permute(1, 2, 0).cpu().numpy()
        axes[0].imshow(img_np)
        axes[0].set_title('Original Image')
        
        # Grad-CAM heatmap
        axes[1].imshow(cam_upsampled, cmap='jet')
        axes[1].set_title('Grad-CAM Heatmap')
        
        # Overlay
        axes[2].imshow(img_np)
        axes[2].imshow(cam_upsampled, cmap='jet', alpha=0.4)
        axes[2].set_title('Overlay')
        
        plt.tight_layout()
        return fig
```

### 2.3 Attention Rollout for Text Encoder

**What it does:** Multiplies attention matrices across all Transformer layers to get per-token importance (how much each input token contributes to the output).

```python
# Create: xai/attention_rollout_text.py

import torch
import numpy as np

class AttentionRolloutText:
    """
    Attention Rollout for TextEncoder_FSM.
    Captures attention weights from every encoder block and 
    computes cumulative attention flow from input to output.
    """
    def __init__(self, model):
        self.model = model
        self.attention_maps = []
        
        text_encoder = model.text_encoder
        for block in text_encoder.blocks:
            block.attn.register_forward_hook(self._save_attention)
    
    def _save_attention(self, module, input, output):
        # The Attention class computes attn internally
        # We need to hook into the softmax output
        # Recalculate from the stored qkv
        B, N, C = input[0].shape
        qkv = module.qkv(input[0]).reshape(B, N, 3, module.num_heads, C // module.num_heads).permute(2, 0, 3, 1, 4)
        q, k, v = qkv[0], qkv[1], qkv[2]
        attn = (q @ k.transpose(-2, -1)) * module.scale
        attn = attn.softmax(dim=-1)  # [B, H, N, N]
        self.attention_maps.append(attn.detach().cpu())
    
    def compute(self, text, ta_perform='textr'):
        """
        Returns per-token importance scores [B, seq_len].
        """
        self.attention_maps = []
        
        with torch.no_grad():
            self.model(text=text, ta_perform=ta_perform)
        
        # Rollout: multiply attention matrices across layers
        # Average over heads first
        result = None
        for attn in self.attention_maps:
            # attn: [B, H, N, N]
            attn_avg = attn.mean(dim=1)  # [B, N, N]
            
            # Add identity (residual connections)
            I = torch.eye(attn_avg.size(-1)).unsqueeze(0)
            attn_avg = 0.5 * attn_avg + 0.5 * I
            
            # Re-normalize rows
            attn_avg = attn_avg / attn_avg.sum(dim=-1, keepdim=True)
            
            if result is None:
                result = attn_avg
            else:
                result = torch.matmul(result, attn_avg)
        
        # Extract importance from CLS token row (or first token)
        # result[:, 0, :] gives how much CLS attends to each token
        token_importance = result[:, 0, :]  # [B, N]
        
        # Normalize
        token_importance = token_importance / token_importance.max(dim=1, keepdim=True)[0]
        
        return token_importance
```

### 2.4 FastSHAP for Cross-Modal Budget Allocation

**What it does:** Trains a small "explainer" network that approximates Shapley values for each modality's contribution to the final output. Used to decide how to split the transmission budget across modalities.

```python
# Create: xai/fast_shap_crossmodal.py

import torch
import torch.nn as nn
import numpy as np
from itertools import product

class FastSHAPCrossModal:
    """
    FastSHAP approximation for cross-modal contribution scoring.
    
    For 3 modalities (image, text, speech), there are 2^3 = 8
    possible coalitions. We approximate Shapley values by
    training a small network to predict the model's output
    for each coalition.
    """
    def __init__(self, model, num_modalities=3):
        self.model = model
        self.num_modalities = num_modalities
        
        # Explainer network: maps model activations → Shapley values
        self.explainer = nn.Sequential(
            nn.Linear(128 * num_modalities, 256),
            nn.ReLU(),
            nn.Linear(256, 64),
            nn.ReLU(),
            nn.Linear(64, num_modalities),
            nn.Softmax(dim=-1)
        )
    
    def compute_coalition_values(self, img, text, speech, ta_perform, criterion, targets):
        """
        Evaluate model output for all 2^M coalitions.
        A coalition masks/unmasks each modality.
        Returns dict: coalition_binary → output_value
        """
        values = {}
        for coalition in product([0, 1], repeat=self.num_modalities):
            # coalition = (img_present, text_present, speech_present)
            c_img = img if coalition[0] else torch.zeros_like(img)
            c_text = text if coalition[1] else torch.zeros_like(text)
            c_speech = speech if coalition[2] else torch.zeros_like(speech)
            
            with torch.no_grad():
                output = self.model(img=c_img, text=c_text, speech=c_speech,
                                    ta_perform=ta_perform)
                if isinstance(output, dict):
                    output = output['outputs']
                loss = criterion(output, targets)
                values[coalition] = -loss.item()  # Negative loss = value
        
        return values
    
    def compute_shapley_exact(self, coalition_values):
        """
        Compute exact Shapley values from coalition values.
        For M=3 modalities, this is tractable (8 coalitions).
        """
        M = self.num_modalities
        shapley = np.zeros(M)
        
        for i in range(M):
            for coalition in product([0, 1], repeat=M):
                if coalition[i] == 1:
                    # Coalition without player i
                    without_i = list(coalition)
                    without_i[i] = 0
                    without_i = tuple(without_i)
                    
                    # Marginal contribution
                    s = sum(without_i)
                    weight = (np.math.factorial(s) * np.math.factorial(M - s - 1)) / np.math.factorial(M)
                    marginal = coalition_values[coalition] - coalition_values[without_i]
                    shapley[i] += weight * marginal
        
        # Normalize to proportions
        shapley_positive = np.maximum(shapley, 0)
        total = shapley_positive.sum()
        if total > 0:
            shapley_positive = shapley_positive / total
        else:
            shapley_positive = np.ones(M) / M
        
        return shapley_positive  # [img_share, text_share, speech_share]
```

### 2.5 Faithfulness Validation (Deletion/Insertion Tests)

This is the **empirical proof** that the XAI scores are meaningful:

```python
# Create: xai/faithfulness.py

import torch
import numpy as np
import matplotlib.pyplot as plt

class FaithfulnessTest:
    """
    Deletion test: Remove features in order of importance (most→least).
    If importance scores are meaningful, performance should drop FAST.
    
    Insertion test: Add features in order of importance (most→least).
    If scores are meaningful, performance should RISE FAST.
    
    Compare against random ordering as control.
    """
    def __init__(self, model, criterion):
        self.model = model
        self.criterion = criterion
    
    def deletion_test(self, features, importance_scores, 
                      ta_perform, targets, n_steps=10):
        """
        features: [B, N, D]
        importance_scores: [B, N]
        Returns: list of performance values as features are removed
        """
        B, N, D = features.shape
        sorted_indices = torch.argsort(importance_scores, dim=1, descending=True)
        
        performances = []
        step_size = max(1, N // n_steps)
        
        for k in range(0, N + 1, step_size):
            masked_features = features.clone()
            if k > 0:
                # Zero out the top-k most important features
                for b in range(B):
                    indices_to_remove = sorted_indices[b, :k]
                    masked_features[b, indices_to_remove] = 0
            
            with torch.no_grad():
                output = self.model.decode(masked_features, ta_perform)
                perf = self._compute_metric(output, targets, ta_perform)
            performances.append(perf)
        
        return performances
    
    def deletion_random_baseline(self, features, ta_perform, targets, n_steps=10, n_runs=5):
        """Random deletion ordering as control."""
        all_perfs = []
        B, N, D = features.shape
        
        for _ in range(n_runs):
            random_order = torch.randperm(N).unsqueeze(0).expand(B, -1)
            perfs = self.deletion_test(features, 
                                        torch.randn(B, N),  # random scores
                                        ta_perform, targets, n_steps)
            all_perfs.append(perfs)
        
        return np.mean(all_perfs, axis=0)
    
    def plot_faithfulness(self, xai_deletion, random_deletion, metric_name='PSNR'):
        """Plot deletion curves showing XAI scores are meaningful."""
        fig, ax = plt.subplots(figsize=(8, 6))
        x = np.linspace(0, 100, len(xai_deletion))
        
        ax.plot(x, xai_deletion, 'r-o', label='XAI-guided deletion', linewidth=2)
        ax.plot(x, random_deletion, 'b--s', label='Random deletion', linewidth=2)
        
        ax.set_xlabel('% of features removed (most→least important)')
        ax.set_ylabel(metric_name)
        ax.set_title('Deletion Test: Faithfulness of Importance Scores')
        ax.legend()
        ax.grid(True, alpha=0.3)
        
        # Area Under Deletion Curve (lower = better XAI)
        auc_xai = np.trapz(xai_deletion, x)
        auc_random = np.trapz(random_deletion, x)
        ax.text(0.02, 0.02, f'AUC (XAI): {auc_xai:.1f}\nAUC (Random): {auc_random:.1f}',
                transform=ax.transAxes, fontsize=10, verticalalignment='bottom',
                bbox=dict(boxstyle='round', facecolor='wheat', alpha=0.5))
        
        return fig
    
    def _compute_metric(self, output, targets, ta_perform):
        if ta_perform.startswith('imgr'):
            mse = torch.nn.MSELoss()(output, targets)
            psnr = 10 * torch.log10(1.0 / mse)
            return psnr.item()
        elif ta_perform.endswith('c'):
            _, predicted = output.max(1)
            acc = predicted.eq(targets).float().mean()
            return acc.item()
