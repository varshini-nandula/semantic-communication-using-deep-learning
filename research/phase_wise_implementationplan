## Phase 3 — XAI-Driven FSM Replacement (Primary Contribution)

> **Goal:** Replace the black-box FSM with an explainability-driven feature selector. Transmission decisions are computed directly from XAI scores, not from a learned MLP + Gumbel-Softmax.

### 3.1 Architecture of the XAI Feature Selector

```
┌──────────────────────────────────────────────────────┐
│                XAI-Driven Feature Selector            │
│                                                       │
│  Input: encoded features [B, N, D] + noise_std        │
│                                                       │
│  Step 1: Compute overall transmission ratio δ         │
│          δ = f(SNR), same adaptive logic as base      │
│          K_total = round(N_total × δ)                 │
│                                                       │
│  Step 2: Cross-modal budget allocation (FastSHAP)     │
│          [s_img, s_text, s_spe] = SHAP contributions  │
│          K_img = round(K_total × s_img)               │
│          K_text = round(K_total × s_text)             │
│          K_spe = round(K_total × s_spe)               │
│                                                       │
│  Step 3: Within-modality selection                    │
│          Image:  top-K_img by Grad-CAM scores         │
│          Text:   top-K_text by Attention Rollout      │
│          Speech: top-K_spe by Grad-CAM (spectrogram)  │
│                                                       │
│  Output: selected features [B, K_total, D]            │
│          + importance_scores (for retransmission)      │
└──────────────────────────────────────────────────────┘
```

### 3.2 Implementation

```python
# Create: modules/xai_feature_selector.py

import torch
import torch.nn as nn
import torch.nn.functional as F
import numpy as np

class XAIFeatureSelector(nn.Module):
    """
    Replaces the black-box FSM with an explainability-driven
    feature selector. Feature importance is computed from XAI
    methods (Grad-CAM, Attention Rollout, FastSHAP), not from
    a learned MLP + Gumbel-Softmax.
    
    This is "interpretable by construction" — the selection
    decision IS the explanation.
    """
    def __init__(self, img_embed_dim, text_embed_dim, speech_embed_dim,
                 num_img_patches=49, num_text_tokens=66, num_speech_frames=50):
        super().__init__()
        
        self.num_img_patches = num_img_patches
        self.num_text_tokens = num_text_tokens
        self.num_speech_frames = num_speech_frames
        
        # SNR-to-ratio mapping (learned, same adaptive logic as base paper)
        # But now it's a simple, interpretable function
        self.ratio_net = nn.Sequential(
            nn.Linear(1, 16),
            nn.ReLU(),
            nn.Linear(16, 1),
            nn.Sigmoid()  # Output in [0, 1]
        )
        
        # Cross-modal SHAP explainer (lightweight)
        self.shap_explainer = nn.Sequential(
            nn.Linear(img_embed_dim + text_embed_dim + speech_embed_dim, 128),
            nn.ReLU(),
            nn.Linear(128, 3),  # [img_weight, text_weight, speech_weight]
            nn.Softmax(dim=-1)
        )
    
    def compute_transmission_ratio(self, noise_std):
        """
        Maps channel noise level to transmission ratio.
        Higher noise → more features transmitted (higher ratio).
        """
        snr = 10 * torch.log10((1 / noise_std) ** 2)
        # Normalize SNR to reasonable range
        snr_normalized = (snr + 6) / 18  # Maps [-6, 12] → [0, 1]
        snr_normalized = snr_normalized.clamp(0, 1)
        ratio = self.ratio_net(snr_normalized.unsqueeze(-1))
        return ratio.squeeze(-1)
    
    def forward(self, img_features=None, text_features=None, speech_features=None,
                img_importance=None, text_importance=None, speech_importance=None,
                noise_std=None, ta_perform=None):
        """
        Args:
            img_features:    [B, N_img, D_img] from image encoder
            text_features:   [B, N_text, D_text] from text encoder
            speech_features: [B, N_spe, D_spe] from speech encoder
            img_importance:  [B, N_img] from Grad-CAM
            text_importance: [B, N_text] from Attention Rollout
            speech_importance: [B, N_spe] from Grad-CAM (spectrogram)
            noise_std:       scalar, channel noise std
        
        Returns:
            selected_features: dict of selected features per modality
            selection_masks: dict of binary masks showing what was selected
            importance_scores: dict of importance scores (for retransmission)
        """
        # Step 1: Overall transmission ratio
        ratio = self.compute_transmission_ratio(noise_std)
        
        # Step 2: Modality-specific selection
        selected = {}
        masks = {}
        scores = {}
        
        modalities = []
        if img_features is not None:
            modalities.append(('img', img_features, img_importance, self.num_img_patches))
        if text_features is not None:
            modalities.append(('text', text_features, text_importance, self.num_text_tokens))
        if speech_features is not None:
            modalities.append(('spe', speech_features, speech_importance, self.num_speech_frames))
        
        for mod_name, features, importance, num_features in modalities:
            B = features.shape[0]
            K = max(1, int(num_features * ratio.item()))
            
            # Select top-K by importance score
            _, top_indices = torch.topk(importance, K, dim=1)
            top_indices_sorted, _ = torch.sort(top_indices, dim=1)  # Maintain order
            
            # Gather selected features
            selected_feat = torch.gather(
                features, 1, 
                top_indices_sorted.unsqueeze(-1).expand(-1, -1, features.shape[-1])
            )
            
            # Create selection mask
            mask = torch.zeros(B, num_features, 1, device=features.device)
            mask.scatter_(1, top_indices_sorted.unsqueeze(-1), 1.0)
            
            # Store importance scores of selected features
            selected_importance = torch.gather(importance, 1, top_indices_sorted)
            
            selected[mod_name] = selected_feat
            masks[mod_name] = mask
            scores[mod_name] = selected_importance
        
        return selected, masks, scores
```

