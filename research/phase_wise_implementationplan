# Create: hardware/esp32_bridge.py

import serial
import struct
import time
import numpy as np

class ESP32Bridge:
    def __init__(self, tx_port='COM3', rx_port='COM4', baud=115200):
        self.tx = serial.Serial(tx_port, baud, timeout=1)
        self.rx = serial.Serial(rx_port, baud, timeout=1)
        time.sleep(2)  # Wait for ESP32 reset
    
    def transmit(self, bitstream: np.ndarray) -> np.ndarray:
        """
        Send quantized codebook indices through ESP32 RF link.
        
        Args:
            bitstream: numpy array of uint8 values (codebook indices)
        Returns:
            received: numpy array of uint8 values (potentially corrupted)
        """
        # Chunk into 250-byte ESP-NOW packets
        chunk_size = 250
        received_chunks = []
        
        for i in range(0, len(bitstream), chunk_size):
            chunk = bitstream[i:i+chunk_size].tobytes()
            self.tx.write(chunk)
            time.sleep(0.05)  # Give time for RF transmission
            
            # Read from receiver
            rx_data = self.rx.read(len(chunk))
            if len(rx_data) < len(chunk):
                # Packet loss detected!
                rx_data += b'\x00' * (len(chunk) - len(rx_data))
            received_chunks.append(np.frombuffer(rx_data, dtype=np.uint8))
        
        return np.concatenate(received_chunks)
    
    def close(self):
        self.tx.close()
        self.rx.close()
