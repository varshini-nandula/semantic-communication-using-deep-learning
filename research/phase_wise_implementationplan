### 3.4 Selective Retransmission Module

```python
# Create: modules/selective_retransmission.py

import torch
import numpy as np

class SelectiveRetransmission:
    """
    Explainability-guided selective retransmission.
    
    Logic:
    1. After channel transmission, detect which features were corrupted
       (by comparing received codebook indices to nearest valid entry)
    2. For each corrupted feature, check its importance score
    3. If importance > threshold → retransmit just that feature
    4. If importance < threshold → leave as-is (not worth bandwidth)
    
    This mirrors classical ARQ but the "worth retransmitting?" decision
    is explainability-driven.
    """
    def __init__(self, codebook, importance_threshold=0.7):
        self.codebook = codebook
        self.threshold = importance_threshold
    
    def detect_corruption(self, received_features, original_indices):
        """
        Compare received quantized features against what was sent.
        
        Returns:
            corruption_mask: [B, K] boolean tensor, True = corrupted
            corruption_severity: [B, K] float tensor, distance to nearest codebook entry
        """
        B, K, D = received_features.shape
        flat = received_features.view(-1, D)
        
        # Distance to nearest codebook entry
        dist = torch.sum(flat ** 2, dim=1, keepdim=True) + \
               torch.sum(self.codebook.embedding.weight ** 2, dim=1) - \
               2 * torch.matmul(flat, self.codebook.embedding.weight.t())
        
        min_dist = dist.min(dim=1)[0]  # [BK]
        severity = min_dist.view(B, K)
        
        # Corrupted = distance exceeds learned threshold
        corruption_mask = severity > severity.mean() + severity.std()
        
        return corruption_mask, severity
    
    def decide_retransmission(self, corruption_mask, importance_scores):
        """
        Decide which corrupted features to retransmit.
        
        Returns:
            retransmit_mask: [B, K] boolean, True = retransmit this feature
            n_retransmit: number of features to retransmit
        """
        # Retransmit if: corrupted AND important
        important = importance_scores > self.threshold
        retransmit_mask = corruption_mask & important
        n_retransmit = retransmit_mask.sum().item()
        
        return retransmit_mask, n_retransmit
    
    def retransmit(self, original_features, retransmit_mask, received_features,
                   channel_fn, noise_std):
        """
        Re-send only the selected features through the channel.
        Uses the original (uncorrupted) copy from the transmitter.
        Fresh noise draw on the retransmission.
        """
        B, K, D = original_features.shape
        result = received_features.clone()
        
        for b in range(B):
            retx_indices = retransmit_mask[b].nonzero(as_tuple=True)[0]
            if len(retx_indices) > 0:
                # Retransmit through channel with fresh noise
                retx_features = original_features[b, retx_indices]
                retx_received = channel_fn(retx_features.unsqueeze(0), noise_std)
                result[b, retx_indices] = retx_received.squeeze(0)
        
        return result
    
    def compute_overhead(self, retransmit_mask, total_features):
        """
        Compute retransmission overhead as a fraction of total symbols.
        """
        n_retransmit = retransmit_mask.sum().item()
        overhead_ratio = n_retransmit / total_features
        return overhead_ratio, n_retransmit
```

### 3.5 Training Strategy for XAI-Replaced Model

> [!IMPORTANT]
> You do NOT retrain the entire model from scratch. The strategy is:
> 1. **Freeze** the encoder backbones (pretrained from baseline)
> 2. **Train** only the XAI selector's ratio_net and the decoder's adaptation
> 3. **Fine-tune** end-to-end with a very small learning rate

```python
# Training configuration for XAI model
def setup_xai_training(baseline_checkpoint_path):
    # Load trained baseline
    baseline = load_baseline(baseline_checkpoint_path)
    
    # Create XAI model
    xai_model = UDeepSC_XAI(baseline, ...)
    
    # Freeze encoder backbones
    for param in xai_model.img_encoder_backbone.parameters():
        param.requires_grad = False
    for param in xai_model.text_encoder_backbone.parameters():
        param.requires_grad = False
    for param in xai_model.spe_encoder_backbone.parameters():
        param.requires_grad = False
    
    # Only train: ratio_net + decoder adaptation
    trainable_params = list(xai_model.xai_selector.parameters()) + \
                       list(xai_model.decoder.parameters())
    
    optimizer = torch.optim.AdamW(trainable_params, lr=1e-4)
    
    return xai_model, optimizer
